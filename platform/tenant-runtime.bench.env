# Rollback of tenants to the bench image. Append these three lines to a
# tenant's project .env (the file docker-compose.tenant.yml reads) and run
# `docker compose up -d` for that tenant. Remove them to go back to Ignition.
# Note: the sites volume holds a different layout per runtime. A tenant created
# on Ignition must be restored from backup into bench, not just re-pointed.
TENANT_IMAGE=ghcr.io/rokctai/occultation/rpanel-tenant:latest
TENANT_COMMAND=bench start
TENANT_SITES_PATH=/home/frappe/frappe-bench/sites
