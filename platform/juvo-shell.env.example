# Runtime environment for the VPS-hosted juvo shell (docker-compose.yml
# service `juvo-shell`). NAMES ONLY - never commit values. Copy to
# platform/juvo-shell.env (gitignored) on the VPS and fill it there; the values
# themselves live in the private RokctAI/occultation workspace.
#
# The list mirrors RokctAI/delivery-frontend/.env.example (the shell is the
# source of truth for what it reads); anything NEXT_PUBLIC_* is inlined at
# build time by Next.js and belongs in the image build args, not here, except
# where the shell also reads it at runtime.

# Public origin of this deployment (canonical URL / metadataBase), e.g. the
# shell domain rpanel proxies to http://juvo-shell:3000. Also passed as a
# build arg because Next.js inlines it.
NEXT_PUBLIC_SITE_URL=

# Base origin of the Frappe CONTROL site this shell talks to. Inside the hub
# compose project the control container is reachable as http://app:8000;
# the public origin works too.
ROKCT_BASE_URL=
NEXT_PUBLIC_ROKCT_BASE_URL=

# Tenant host resolution (base_sdk kernel): static host -> site map, or the
# registered control resolver plus its cache TTLs. All optional.
ROKCT_TENANT_HOSTS=
ROKCT_TENANT_HOST_LOOKUP=
ROKCT_TENANT_HOST_TTL_MS=
ROKCT_TENANT_HOST_NEGATIVE_TTL_MS=

# NextAuth signing secret (auth_sdk). Required at runtime.
AUTH_SECRET=

# auth_sdk's local Postgres tenant link (drizzle). The shell reads POSTGRES_URL;
# DATABASE_URL is listed for operators whose tooling expects that name and
# should carry the same value.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=
