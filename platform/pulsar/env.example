# Copy to platform/pulsar/.env and fill in. Never commit the filled file.
PULSAR_DB_ROOT_PASSWORD=
PULSAR_HUB_ADMIN_PASSWORD=
PULSAR_TENANT_ADMIN_PASSWORD=
# Optional
# PULSAR_HUB_SITE=hub.localhost
# PULSAR_TENANT_DOMAIN=tenants.localhost
# PULSAR_TENANT_SITE=acme.tenants.localhost
# PULSAR_HUB_PORT=8100
# PULSAR_TENANT_PORT=8101
# PULSAR_HUB_URL=https://hub.example.com   (the hub's public URL; tenants get it as control_plane_url at setup)
# For a tenant on this compose network, add to the hub site's site_config.json:
#   "control_plane_scheme": "http", "provision_callback_allow_private": 1
